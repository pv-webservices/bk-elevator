---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/overlays.css';
import '../styles/home.css';
import '../styles/home-scenes.css';
import '../styles/home-finale.css';
import '../styles/pages.css';
import '../styles/pages-detail.css';
import { company } from '../data/site';
interface Props {
  title: string;
  description: string;
  image?: string;
  home?: boolean;
}
const {
  title,
  description,
  image = '/images/cabins/cabin-8.webp',
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://bkelevator.in');
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://bkelevator.in/',
    },
    ...(!home
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonical.href,
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07090b" />
    <meta name="description" content={description} />
    <title>{title} | {company.name}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${company.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, canonical.origin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonical.origin)} />
    {home && (
      <link
        rel="preload"
        href="/images/cabins/cabin-8-720.webp"
        imagesrcset="/images/cabins/cabin-8-480.webp 480w, /images/cabins/cabin-8-720.webp 720w, /images/cabins/cabin-8.webp 1000w"
        imagesizes="(max-width: 900px) 88vw, 40vw"
        as="image"
      />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: company.name,
        url: canonical.origin,
        telephone: '+91' + company.phone,
        email: company.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: '4841/G/32, Chakrapani Nagar',
          addressLocality: 'Nagpur',
          postalCode: '440015',
          addressCountry: 'IN',
        },
      })}
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  </head>
  <body id="top" class:list={{ 'is-home': home }}>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <dialog class="video-dialog" aria-labelledby="video-dialog-title">
      <div class="dialog-header">
        <h2 id="video-dialog-title">Video showcase</h2>
        <button class="dialog-close" aria-label="Close video">
          <Icon name="close" />
        </button>
      </div>
      <video controls playsinline preload="none"></video>
      <p>Original elevator footage · Bk Elevator Pvt. Ltd</p>
    </dialog>
    <dialog class="image-dialog" aria-labelledby="image-dialog-title">
      <div class="dialog-header">
        <h2 id="image-dialog-title">Cabin design</h2>
        <span class="dialog-count" data-dialog-count></span>
        <button class="dialog-close" aria-label="Close image">
          <Icon name="close" />
        </button>
      </div>
      <div class="dialog-stage">
        <button class="dialog-nav dialog-prev" data-dialog-prev aria-label="Previous image">
          <Icon name="arrow-left" />
        </button>
        <img src="/images/cabins/cabin-8-480.webp" alt="" />
        <button class="dialog-nav dialog-next" data-dialog-next aria-label="Next image">
          <Icon />
        </button>
      </div>
      <a class="btn" id="image-enquiry" href="/enquiry/?interest=Cabin+design">
        <span>Enquire about this design</span><Icon size={16} />
      </a>
    </dialog>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
