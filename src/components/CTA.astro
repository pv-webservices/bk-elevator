---
import Icon from './Icon.astro';
import { company } from '../data/site';

interface Props {
  floor?: boolean;
}
const { floor = false } = Astro.props;
---

<section
  class="cta-scene"
  id={floor ? 'floor-10' : 'contact-cta'}
  data-cta
  {...floor ? { 'data-floor': '10', 'data-floor-name': 'Your next level' } : {}}
>
  <div class="cta-backdrop" aria-hidden="true">
    <img
      src="/images/cabins/cabin-5.webp"
      srcset="/images/cabins/cabin-5-720.webp 720w, /images/cabins/cabin-5.webp 1000w"
      sizes="60vw"
      alt=""
      loading="lazy"
      width="1000"
      height="1400"
    />
  </div>
  <div class="cta-doors" aria-hidden="true">
    <span class="cta-door cta-door-left"></span>
    <span class="cta-door cta-door-right"></span>
  </div>
  <div class="wide cta-content">
    <div class="eyebrow eyebrow-center">
      {floor ? <span class="floor-tag">10</span> : <Icon name="spark" size={14} />}
      THE PENTHOUSE · YOUR NEXT LEVEL
    </div>
    <h2 class="cta-title" data-reveal>
      Let’s elevate <em>your vision.</em>
    </h2>
    <p data-reveal>
      A new building, a considered upgrade or care for an existing lift. A better journey begins with one
      conversation.
    </p>
    <div class="button-row button-row-center" data-reveal>
      <a href="/enquiry/" class="btn btn-large"><span>Get a free quote</span><Icon /></a>
      <a href={`tel:+91${company.phone}`} class="btn btn-ghost btn-large">
        <span>Call +91 {company.phone}</span><Icon name="phone" size={18} />
      </a>
    </div>
  </div>
</section>
