---
import Icon from '../Icon.astro';

const statement =
  'An elevator is part of the way a building lives. We bring its design, engineering and service into one considered conversation — so every ride feels effortless.';
const words = statement.split(' ');
const principles = [
  ['01', 'Purposeful design', 'Interiors and interfaces shaped around your building and the people who use it.', 'diamond'],
  ['02', 'System thinking', 'Doors, drives, ropes, rails and controls selected to work as one.', 'gear'],
  ['03', 'Lasting care', 'Maintenance, upgrades and AMC support long after handover.', 'shield'],
];
---

<section class="section light intro" id="floor-2" data-floor="2" data-floor-name="Our story">
  <div class="wide intro-grid">
    <div class="intro-statement">
      <div class="eyebrow"><span class="floor-tag">02</span> Who we are</div>
      <p class="fill-text" data-fill-text>
        {words.map((w) => <span>{w} </span>)}
      </p>
      <a class="text-link" href="/about/">Discover our company <Icon size={18} /></a>
    </div>
    <div class="intro-visual">
      <figure class="intro-image" data-reveal="clip">
        <img
          src="/images/mechanism/lift mechanism-2.webp"
          alt="Elevator technician working inside a lift shaft beside the guide rails"
          width="1200"
          height="800"
          loading="lazy"
          data-parallax="0.12"
        />
        <figcaption>
          <span class="badge-live"><span class="pulse-dot"></span> On site</span>
          Precision in every installation
        </figcaption>
      </figure>
      <div class="principles">
        {
          principles.map(([n, title, text, icon], i) => (
            <article class="principle card-hover" data-reveal style={`--i:${i}`}>
              <span class="principle-icon">
                <Icon name={icon} size={22} />
              </span>
              <div>
                <small>{n}</small>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
