---
import Icon from '../Icon.astro';
import CabinCard from '../CabinCard.astro';
import { cabins } from '../../data/site';
---

<section class="hpin collection" id="floor-3" data-floor="3" data-floor-name="Cabin collection" data-hpin>
  <div class="hpin-sticky">
    <div class="wide hpin-head">
      <div>
        <div class="eyebrow"><span class="floor-tag">03</span> The cabin collection</div>
        <h2>An everyday journey. <em>An exceptional space.</em></h2>
      </div>
      <div class="hpin-aside">
        <p>Ten signature interiors — mirrored gold, warm copper and dark reflective finishes.</p>
        <a class="text-link" href="/cabin-designs/">View all designs <Icon size={18} /></a>
      </div>
    </div>
    <div class="hpin-viewport" data-hpin-viewport>
      <div class="hpin-track" data-hpin-track>
        {cabins.map((cabin, i) => <CabinCard cabin={cabin} index={i} sizes="(max-width: 600px) 72vw, 340px" />)}
        <a class="hpin-end card-hover" href="/cabin-designs/">
          <span class="hpin-end-icon"><Icon name="cabin" size={30} /></span>
          <strong>Find your signature cabin</strong>
          <span>Filter the full collection by finish and enquire in one tap.</span>
          <span class="btn btn-small"><span>Open the collection</span><Icon size={15} /></span>
        </a>
      </div>
    </div>
    <div class="wide hpin-foot">
      <span class="hpin-hint"><Icon name="arrow" size={16} /> Keep scrolling to travel the collection</span>
      <div class="hpin-progress" aria-hidden="true"><span data-hpin-progress></span></div>
    </div>
  </div>
</section>
